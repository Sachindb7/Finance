# ===== API KEYS =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== INSTAGRAM (Optional - only needed for auto-publish) =====
INSTAGRAM_USER_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token

# ===== CLOUDINARY (Optional - only needed for Instagram auto-publish) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== YOUTUBE (Optional - uses client_secret.json + token.json instead) =====
YOUTUBE_PRIVACY=public

# ===== VIDEO SETTINGS =====
SLIDE_DURATION=5
VIDEO_FPS=30
FONT_SIZE=46
MUSIC_VOLUME=0.15
